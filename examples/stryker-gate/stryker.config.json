{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/price.js"
  ],
  "reporters": [
    "json",
    "clear-text"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "npm test"
  },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "thresholds": {
    "break": null
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  }
}
